# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (MySQL 8, local) ---
DB_NAME=sistema_caja
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=False

# --- Facturación electrónica (reintentos / contingencia) ---
FACTURACION_MAX_REINTENTOS=5
FACTURACION_BACKOFF_BASE_SEGUNDOS=60

# --- Siigo (Proveedor Tecnológico único) ---
SIIGO_AUTH_URL=https://api.siigo.com/auth
SIIGO_API_BASE_URL=https://api.siigo.com

# --- Cifrado de campos en reposo (credenciales Siigo) ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=genera-una-clave-fernet-propia
